fcrepo.namespace.registry=/fcrepo-home/config/custom_namespaces.yml
# needed to avoid h2-db-locked-bug
# fcrepo.db.url=jdbc:h2:file:/data/sample;AUTO_SERVER=TRUE

# enables / disables auto-versioning
# (see OCFL mutable head extension)
fcrepo.autoversioning.enabled=false

# fcrepo metrics (https://wiki.lyrasis.org/display/FEDORAM6M1P0/Metrics)
# reachable under: http://[FCREPO-HOST]/prometheus  (false/true)
fcrepo.metrics.enable=false

# Rebuild index on start (false/true)
fcrepo.rebuild.on.start=false

# FCRepo storage layer (ocfl-fs/ocfl-s3)
fcrepo.storage=ocfl-fs

###
# Auth properties
# enabled? (true/false)
fcrepo.auth.enabled=false
# fcrepo.auth.principal.header.enabled=true 
# fcrepo.auth.principal.header.name=x-principal-header
# fcrepo.auth.principal.roles.list=sebi
# fcrepo.auth.principal.header.separator=,
# fcrepo.auth.principal.delegate.enabled=true


### configuration of relation fedora database
fcrepo.db.url=jdbc:postgresql://fedora_postgres:5432/fcrepo
fcrepo.db.user=fcrepo-user
fcrepo.db.password=fcrepo-pw

fcrepo.jms.enabled=true
# base url where resources should be stored.
fcrepo.jms.baseUrl=http://fcrepo:8080/rest/



# path of active mq configuration file
# value corresponds to configuration description from activemq
# by default a classpath is awaited
fcrepo.activemq.configuration=file:/fcrepo-home/config/activemq.xml

# will overwrite settings from activemq.xml!!!
# this will treat all toolbox processes as queue
# =pull based messaging system from toolbox perspective! (instead of topic / push based )
# fcrepo.jms.destination.type=queue